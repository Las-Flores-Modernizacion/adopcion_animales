<% content_for :title, "Mi Perfil" %>

<div class="max-w-lg mx-auto py-8 px-4 sm:px-6 w-full">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-neutral-900 dark:text-white">Mi perfil</h1>
    <p class="text-neutral-500 mt-2">
      Este teléfono se usa para que otros vecinos o el área de Cuidado Animal del municipio puedan
      contactarte cuando le des tránsito a un animal o pidas adoptarlo.
    </p>
  </div>

  <%= form_with model: @account, url: profile_path, method: :patch, class: "space-y-6" do |form| %>
    <% if @account.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/30 p-4 rounded-xl border border-red-200 dark:border-red-800">
        <ul class="text-sm text-red-700 dark:text-red-300 list-disc pl-5">
          <% @account.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-5">
      <%= render "shared/components/forms/form_group",
          label: "Nombre",
          helper_text: "Viene de tu cuenta de Google, no se puede editar acá." do %>
        <%= text_field_tag nil, @account.full_name.titleize, class: "form-control", disabled: true %>
      <% end %>

      <%= render "shared/components/forms/form_group",
          label: "Teléfono de contacto",
          name: "account[phone_number]",
          helper_text: "Ej. 2244 555555" do %>
        <%= form.text_field :phone_number, class: "form-control" %>
      <% end %>
    </div>

    <div class="flex justify-end">
      <%= render "shared/components/buttons/button",
          text: "Guardar",
          type: "submit",
          style: "fancy",
          variant: "primary"
      %>
    </div>
  <% end %>
</div>
