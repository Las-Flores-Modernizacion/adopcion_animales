<%#
  Report Card
  Card usada en el listado de reportes (propios y de la comunidad).

  Required locals:
    - report: Report

  Optional locals:
    - own: Boolean (default: false) - Si es true, muestra el badge de borrador y el botón
      "Editar" en vez de "Ayudar".
    - slidable: Boolean (default: false) - Si es true y el reporte tiene más de una foto, la
      miniatura es un carrusel deslizable (controles superpuestos). Si es false, se muestra
      solo la primera foto con un badge de conteo.
%>

<% own = local_assigns.fetch(:own, false) %>
<% slidable = local_assigns.fetch(:slidable, false) %>
<% animal = report.animal %>

<% media = capture do %>
  <% if report.photo.attached? %>
    <% if slidable && report.photo.count > 1 %>
      <% slides = report.photo.map { |p| { content: image_tag(p, class: "w-full h-48 object-cover") } } %>
      <%= render "shared/components/carousel/carousel",
          slides: slides,
          slide_size: "full",
          dots: true,
          buttons: true,
          show_gradients: false,
          edge_to_edge: true,
          overlay: true
      %>
    <% else %>
      <%= image_tag report.photo.first, class: "w-full h-full object-cover" %>

      <% if report.photo.count > 1 %>
        <div class="absolute bottom-3 left-3 z-20">
          <%= render "shared/components/badge/badge", text: "+#{report.photo.count - 1} fotos", variant: "neutral", classes: "!bg-black/60 dark:!bg-black/60 !text-white backdrop-blur" %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="w-full h-full flex flex-col items-center justify-center text-neutral-400 dark:text-neutral-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span class="text-xs font-medium">Sin foto</span>
    </div>
  <% end %>

  <% if own && report.user_id == Current.user.id && report.draft? %>
    <div class="absolute top-3 right-3 z-20">
      <%= render "shared/components/badge/badge", text: "Borrador", variant: "yellow" %>
    </div>
  <% end %>
<% end %>

<%= render "shared/components/card/card",
    padding: "none",
    shadow: "sm",
    hoverable: true,
    media_content: media,
    image_classes: "h-48 flex-shrink-0",
    classes: "flex flex-col" do %>
  <div class="p-4 flex flex-col flex-grow">
    <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-1 capitalize truncate">
      <%= animal&.species.presence || "Especie desconocida" %>
    </h3>

    <div class="space-y-1.5 text-sm text-neutral-600 dark:text-neutral-300 mb-4 flex-grow">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
        <span class="truncate"><%= animal&.race.presence || "Raza sin especificar" %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span><%= animal&.age.present? ? "#{animal.age} años aprox." : "Edad sin especificar" %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span class="truncate"><%= report.location ? "Ubicación adjunta" : "Sin ubicación" %></span>
      </div>
    </div>

    <div class="mt-auto pt-4 border-t border-neutral-100 dark:border-neutral-800 flex gap-2">
      <% if own %>
        <% unless report.draft? %>
          <%= render "shared/components/buttons/button", text: "Ver", href: report_path(report), variant: "secondary", size: "sm", classes: "flex-1" %>
        <% end %>
        <%= render "shared/components/buttons/button", text: "Editar", href: edit_report_path(id: report.id), variant: "outline", size: "sm", classes: "flex-1" %>
      <% else %>
        <%= render "shared/components/buttons/button", text: "Ver", href: report_path(report), variant: "secondary", size: "sm", classes: "flex-1" %>
        <% unless report.status.in?(%w[adoptado encontrado]) %>
          <%= render "reports/help_menu", report: report, classes: "flex-1", direction: "up" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
