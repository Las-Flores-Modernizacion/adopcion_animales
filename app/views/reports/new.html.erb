<% content_for :title, "Nuevo Reporte" %>

<div class="max-w-2xl mx-auto py-8 px-4 sm:px-6">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-neutral-900 dark:text-white">Reportar Animal</h1>
    <p class="text-neutral-500 mt-2">Toma o sube fotos del animal y confirma tu ubicación GPS para iniciar el reporte.</p>
  </div>

  <%= form_with(
    model: @report,
    url: reports_path,
    method: :post,
    class: "space-y-6",
    data: { controller: "gps" }
  ) do |form| %>

    <% if @report.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/30 p-4 rounded-xl border border-red-200 dark:border-red-800">
        <h3 class="text-sm font-medium text-red-800 dark:text-red-400">Por favor revisa los siguientes errores:</h3>
        <ul class="mt-2 text-sm text-red-700 dark:text-red-300 list-disc pl-5">
          <% @report.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Coordenadas ocultas -->
    <%= hidden_field_tag "location[browser_lat]", nil, data: { gps_target: "lat" } %>
    <%= hidden_field_tag "location[browser_lng]", nil, data: { gps_target: "lng" } %>

    <!-- Vinculación a un animal ya reportado -->
    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-3">
      <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">¿Ya viste este animal reportado?</h3>
      <p class="text-sm text-neutral-500">Si es un animal que ya fue reportado por vos o por otra persona, buscalo y vinculá este nuevo avistamiento. Si no, dejalo en blanco y vas a poder describirlo en el siguiente paso.</p>

      <%= render "shared/components/select/select",
          name: "report[animal_id]",
          url: animals_path,
          value_field: "id",
          label_field: "label",
          dropdown_input: true,
          placeholder: "Buscar animal ya reportado (opcional)...",
          dropdown_input_placeholder: "Especie, color, raza..." %>
    </div>

    <!-- Selección de Fotos -->
    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-4" data-controller="image-preview">
      <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Fotografías del Animal</h3>

      <!-- Contenedor dinámico de previsualización JS -->
      <div data-image-preview-target="previewContainer" class="hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-4">
      </div>

      <%= form.file_field :photo,
          multiple: true,
          direct_upload: true,
          data: {
            "image-preview-target": "master",
            action: "change->image-preview#renderPreviews"
          },
          class: "hidden" %>

      <!-- UI Compacta de Subida con Componente Button -->
      <div class="p-6 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/30 text-center flex flex-col items-center justify-center gap-4 transition-colors hover:border-neutral-400 dark:hover:border-neutral-500">
        <div class="p-3 rounded-full bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-neutral-900 dark:text-white">Selecciona o toma fotos del animal</p>
          <p class="text-xs text-neutral-500 mt-1">Formatos: JPG, PNG, WEBP, AVIF, HEIC</p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 w-full sm:w-auto">
          <!-- Botón Cámara -->
          <div data-controller="compressor">
            <%= render "shared/components/buttons/button",
                text: "Tomar foto",
                variant: "secondary",
                style: "fancy",
                icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><circle cx="12" cy="13" r="3" stroke-width="2" /></svg>',
                data: { action: "click->image-preview#openCamera" } %>

            <input type="file"
              accept="image/*"
              capture="environment"
              multiple="multiple"
              data-compressor-target="input"
              data-image-preview-target="cameraInput"
              data-action="change->compressor#compress"
              class="hidden" />
          </div>

          <!-- Botón Galería -->
          <div data-controller="compressor">
            <%= render "shared/components/buttons/button",
                text: "Galería",
                variant: "primary",
                style: "fancy",
                icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>',
                data: { action: "click->image-preview#openGallery" } %>

            <input type="file"
              accept="image/*"
              multiple="multiple"
              data-compressor-target="input"
              data-image-preview-target="galleryInput"
              data-action="change->compressor#compress"
              class="hidden" />
          </div>
        </div>
      </div>
    </div>

    <!-- Estado GPS -->
    <div data-gps-target="warning" class="p-4 rounded-xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/50 text-amber-900 dark:text-amber-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div data-gps-target="message" class="flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <div class="text-sm">
          <strong class="font-semibold block sm:inline">Sin ubicación GPS:</strong> Se requiere obtener tu ubicación actual para enviar el reporte.
        </div>
      </div>

      <%= render "shared/components/buttons/button",
          text: "Obtener ubicación GPS",
          type: "button",
          variant: "warning",
          style: "fancy",
          size: "sm",
          data: { "gps-target": "retry", action: "click->gps#checkLocation" }
      %>
    </div>

    <!-- Botón de Envío -->
    <div class="flex justify-end gap-3 pt-2">
      <%= render "shared/components/buttons/button",
          text: "Siguiente paso",
          type: "submit",
          style: "fancy",
          variant: "primary",
          disabled: true,
          data: { "gps-target": "submit", "turbo-submits-with": "Guardando..." },
          classes: "pointer-events-none"
      %>
    </div>
  <% end %>
</div>
