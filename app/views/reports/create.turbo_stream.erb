<%= turbo_stream.replace "step-location-container" do %>
  <div class="flex flex-col items-end gap-1 w-full animate-fade-in">
    <div class="bg-blue-600 p-3.5 rounded-2xl rounded-tr-none text-white max-w-[85%] text-sm shadow-sm">
      📍 Ubicación enviada correctamente.
    </div>
    <%= link_to "Modificar ubicación", edit_step_reports_path(step: "location"), class: "text-[11px] text-neutral-400 hover:underline mr-1" %>
  </div>
<% end %>

<%= turbo_stream.append "chat-timeline" do %>
  <div id="step-photo-permission-container" class="animate-fade-in space-y-3">
    <div class="flex items-start gap-3">
      <div class="bg-neutral-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-neutral-800 max-w-[85%] text-sm">
        ¿Tenés la posibilidad de sacar o subir una foto del animal en este momento? 📸
        <div class="mt-3 flex gap-2">
          <%= button_to "Sí, puedo", answer_photo_permission_reports_path(can_photo: true), method: :post, class: "bg-white border border-neutral-300 text-neutral-700 font-semibold text-xs px-4 py-2 rounded-xl hover:bg-neutral-50 shadow-sm" %>
          <%= button_to "No, no puedo", answer_photo_permission_reports_path(can_photo: false), method: :post, class: "bg-white border border-neutral-300 text-neutral-500 text-xs px-4 py-2 rounded-xl hover:bg-neutral-50 shadow-sm" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
