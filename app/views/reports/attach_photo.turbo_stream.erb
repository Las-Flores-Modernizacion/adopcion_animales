<%= turbo_stream.replace "step-photo-upload-container" do %>
  <div class="flex flex-col items-end gap-1 w-full animate-fade-in">
    <div class="bg-blue-600 p-2.5 rounded-2xl rounded-tr-none text-white max-w-[70%] shadow-sm">
      <p class="text-[11px] font-semibold mb-1.5 text-blue-100">Imagen adjunta:</p>
      <%= image_tag @report.photo.variant(:thumb), class: "rounded-xl max-h-40 w-full object-cover border border-blue-500" if @report.photo.attached? %>
    </div>
    <%= link_to "Cambiar foto", edit_step_reports_path(step: "photo"), class: "text-[11px] text-neutral-400 hover:underline mr-1" %>
  </div>
<% end %>

<%= turbo_stream.append "chat-timeline" do %>
  <%= render "reports/steps/question_species" %>
<% end %>
