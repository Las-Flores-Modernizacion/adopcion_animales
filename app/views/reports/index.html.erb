<div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800 dark:text-neutral-100">Reportes</h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
        Gestiona tus reportes o ayuda a animales de la comunidad.
      </p>
    </div>
    <%= render "shared/components/buttons/button",
      href: new_report_path,
      text: "Nuevo reporte",
      icon: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='currentColor'><path fill-rule='evenodd' d='M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z' clip-rule='evenodd' /></svg>",
      pill: true,
      size: "md",
      style: "fancy"
    %>
  </div>

  <%# Panel 1: Mis Reportes %>
  <% own_panel = capture do %>
    <% if @own_reports.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @own_reports.each do |report| %>
          <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow-sm dark:shadow-neutral-950/30 border border-neutral-200 dark:border-neutral-800 overflow-hidden flex flex-col transition hover:shadow-md">
            <!-- Card Header / Image -->
            <div class="relative h-48 bg-neutral-100 dark:bg-neutral-800 flex-shrink-0">
              <% if report.photo.attached? %>
                <%= image_tag report.photo, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-neutral-400 dark:text-neutral-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="text-xs font-medium">Sin foto</span>
                </div>
              <% end %>

              <!-- Badge -->
              <div class="absolute top-3 right-3 flex flex-col gap-1 items-end">
                <% if report.user_id == Current.user.id && report.draft? %>
                  <span class="bg-yellow-100/90 dark:bg-yellow-950/80 backdrop-blur text-yellow-800 dark:text-yellow-300 text-xs font-bold px-2.5 py-1 rounded-lg border border-yellow-200 dark:border-yellow-800/60 shadow-sm">Borrador</span>
                <% end %>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-4 flex flex-col flex-grow">
              <% animal = report.animal %>
              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-1 capitalize truncate">
                <%= animal&.species.presence || "Especie desconocida" %>
              </h3>

              <div class="space-y-1.5 text-sm text-neutral-600 dark:text-neutral-300 mb-4 flex-grow">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                  <span class="truncate"><%= animal&.race.presence || "Raza sin especificar" %></span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span><%= animal&.age.present? ? "#{animal.age} años aprox." : "Edad sin especificar" %></span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  <span class="truncate"><%= report.location ? "Ubicación adjunta" : "Sin ubicación" %></span>
                </div>
              </div>

              <div class="mt-auto pt-4 border-t border-neutral-100 dark:border-neutral-800">
                <% if report.draft? %>
                  <%= link_to new_report_path(report_id: report.id), class: "block w-full text-center bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-200 font-semibold text-sm px-4 py-2.5 rounded-xl transition" do %>
                    Continuar edición
                  <% end %>
                <% else %>
                  <button class="block w-full text-center bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-400 dark:text-neutral-600 font-semibold text-sm px-4 py-2.5 rounded-xl cursor-not-allowed">
                    Finalizado
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-neutral-50 dark:bg-neutral-900/50 rounded-3xl border border-neutral-100 dark:border-neutral-800">
        <div class="bg-blue-100 dark:bg-blue-950/60 p-4 rounded-full mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10 text-blue-600 dark:text-blue-400">
            <path d="M 4 8.8 C 3.01 8.8 2.2 10.01 2.2 11.5 C 2.2 12.99 3.01 14.2 4 14.2 C 4.99 14.2 5.8 12.99 5.8 11.5 C 5.8 10.01 4.99 8.8 4 8.8 Z M 8.8 3.8 C 7.7 3.8 6.8 5.14 6.8 6.8 C 6.8 8.46 7.7 9.8 8.8 9.8 C 9.9 9.8 10.8 8.46 10.8 6.8 C 10.8 5.14 9.9 3.8 8.8 3.8 Z M 15.2 3.8 C 14.1 3.8 13.2 5.14 13.2 6.8 C 13.2 8.46 14.1 9.8 15.2 9.8 C 16.3 9.8 17.2 8.46 17.2 6.8 C 17.2 5.14 16.3 3.8 15.2 3.8 Z M 20 8.8 C 19.01 8.8 18.2 10.01 18.2 11.5 C 18.2 12.99 19.01 14.2 20 14.2 C 20.99 14.2 21.8 12.99 21.8 11.5 C 21.8 10.01 20.99 8.8 20 8.8 Z M 12 11.5 C 9.6 11.5 7.2 13.1 6.6 15.7 C 6 18.2 7.8 20.5 10.6 20.9 C 11.5 21 12 20.7 12 20.7 C 12 20.7 12.5 21 13.4 20.9 C 16.2 20.5 18 18.2 17.4 15.7 C 16.8 13.1 14.4 11.5 12 11.5 Z" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">No tienes reportes todavía</h2>
        <p class="text-neutral-500 dark:text-neutral-400 max-w-sm mb-6">Parece que aún no has creado ningún reporte de animales. ¡Haz tu primer reporte ahora mismo!</p>
      </div>
    <% end %>
  <% end %>

  <%# Panel 2: Comunidad %>
  <% community_panel = capture do %>
    <% if @community_reports.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @community_reports.each do |report| %>
          <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow-sm dark:shadow-neutral-950/30 border border-neutral-200 dark:border-neutral-800 overflow-hidden flex flex-col transition hover:shadow-md">
            <!-- Card Header / Image -->
            <div class="relative h-48 bg-neutral-100 dark:bg-neutral-800 flex-shrink-0">
              <% if report.photo.attached? %>
                <%= image_tag report.photo, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-neutral-400 dark:text-neutral-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="text-xs font-medium">Sin foto</span>
                </div>
              <% end %>
            </div>

            <!-- Card Body -->
            <div class="p-4 flex flex-col flex-grow">
              <% animal = report.animal %>
              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-1 capitalize truncate">
                <%= animal&.species.presence || "Especie desconocida" %>
              </h3>

              <div class="space-y-1.5 text-sm text-neutral-600 dark:text-neutral-300 mb-4 flex-grow">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                  <span class="truncate"><%= animal&.race.presence || "Raza sin especificar" %></span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span><%= animal&.age.present? ? "#{animal.age} años aprox." : "Edad sin especificar" %></span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  <span class="truncate"><%= report.location ? "Ubicación adjunta" : "Sin ubicación" %></span>
                </div>
              </div>

              <div class="mt-auto pt-4 border-t border-neutral-100 dark:border-neutral-800">
                <%= render "shared/components/buttons/button",
                  text: "Ayudar",
                  href: "#",
                  style: "fancy",
                  variant: "info",
                  classes: "block w-full"
                %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-neutral-50 dark:bg-neutral-900/50 rounded-3xl border border-neutral-100 dark:border-neutral-800">
        <div class="bg-blue-100 dark:bg-blue-950/60 p-4 rounded-full mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10 text-blue-600 dark:text-blue-400">
            <path d="M 4 8.8 C 3.01 8.8 2.2 10.01 2.2 11.5 C 2.2 12.99 3.01 14.2 4 14.2 C 4.99 14.2 5.8 12.99 5.8 11.5 C 5.8 10.01 4.99 8.8 4 8.8 Z M 8.8 3.8 C 7.7 3.8 6.8 5.14 6.8 6.8 C 6.8 8.46 7.7 9.8 8.8 9.8 C 9.9 9.8 10.8 8.46 10.8 6.8 C 10.8 5.14 9.9 3.8 8.8 3.8 Z M 15.2 3.8 C 14.1 3.8 13.2 5.14 13.2 6.8 C 13.2 8.46 14.1 9.8 15.2 9.8 C 16.3 9.8 17.2 8.46 17.2 6.8 C 17.2 5.14 16.3 3.8 15.2 3.8 Z M 20 8.8 C 19.01 8.8 18.2 10.01 18.2 11.5 C 18.2 12.99 19.01 14.2 20 14.2 C 20.99 14.2 21.8 12.99 21.8 11.5 C 21.8 10.01 20.99 8.8 20 8.8 Z M 12 11.5 C 9.6 11.5 7.2 13.1 6.6 15.7 C 6 18.2 7.8 20.5 10.6 20.9 C 11.5 21 12 20.7 12 20.7 C 12 20.7 12.5 21 13.4 20.9 C 16.2 20.5 18 18.2 17.4 15.7 C 16.8 13.1 14.4 11.5 12 11.5 Z" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">Aún no hay reportes</h2>
        <p class="text-neutral-500 dark:text-neutral-400 max-w-sm mb-6">Parece que ningún usuario ha publicado reportes todavía. ¡Sé el primero en aportar!</p>
      </div>
    <% end %>
  <% end %>

  <%# Renderizado del componente Tabs %>
  <%= render "shared/components/tabs/tabs",
    panel_classes: "py-6",
    tabs: [
      { title: "Mis Reportes" },
      { title: "Comunidad" }
    ],
    panels: [
      own_panel,
      community_panel
    ],
    variant: "low_contrast"
  %>
</div>
