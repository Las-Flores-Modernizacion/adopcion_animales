<div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
    <div>
      <h1 class="">
        Mis Reportes
      </h1>

      <p class="">
        Gestiona y sigue el estado de tus reportes.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "Nuevo Reporte", new_report_path %>
    </div>
  </div>

  <% if @reports.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-1 gap-6">
      <% @reports.each do |report| %>
      <!-- espacio del reporte entero -->
        <div class="flex border ">
          <!--tamaño de la foto-->
          <div class="flex w-50 h-50 object-cover"> 
            <%= image_tag((report.photo.attached? ? report.photo : nil), class: "w-full h-full") %>
          </div>
           <!--informacion del reporte--> 
          <div class="flex items-center">
            <h1 class="justify-end">ubicacion y urgencia<h1>

          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
