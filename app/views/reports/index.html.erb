<div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
  <div class="flex flex-col space-y-4 mb-10">
      <p>
        Gestiona y sigue el estado de tus reportes.
      </p>
      <div class="flex sm:flex-row gap-25 ">
        <h1 class="flex gap-3  w-30">
          Mis Reportes
        </h1>
        <div class="flex items-center gap-3 border-2 w-30">
          <%= link_to "Hacer Reporte", new_report_path %>
        </div>
      </div>
  </div>

  <% if @reports.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-1 gap-6">
      <% @reports.each do |report| %>
      <!-- espacio del reporte entero -->
        <div class="flex border h-30">
          <!--tamaño de la foto-->
          <% if report.photo.attached? %>
            <div class="flex w-50 h-3+0 object-cover"> 
              <%= image_tag(report.photo, class: "w-full h-full") %>
            </div>
          <% else %>
            <p>No hay foto</p>
          <% end %>
           <!--informacion del reporte--> 
          <div class="flex items-center ">
            <!--tamaño de la palabra-->
            <h1 class="flex text-center">ubicacion y urgencia<h1>

          </div> </div> <% end %> </div> <% end %> </div>
