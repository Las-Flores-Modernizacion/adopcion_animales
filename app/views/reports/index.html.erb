<div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800">Reportes</h1>
      <p class="text-sm text-neutral-500 mt-1">
        Gestiona tus reportes o ayuda a animales de la comunidad.
      </p>
    </div>
    <%= link_to new_report_path, class: "inline-flex items-center justify-center gap-2 bg-blue-600 text-white font-semibold px-5 py-2.5 rounded-xl hover:bg-blue-700 transition shadow-sm w-full sm:w-auto" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      Nuevo Reporte
    <% end %>
  </div>

  <!-- Tabs -->
  <div class="border-b border-neutral-200 mb-8">
    <nav class="-mb-px flex gap-6" aria-label="Tabs">
      <%= link_to reports_path(tab: 'own'), class: "whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition #{ @current_tab == 'own' ? 'border-blue-500 text-blue-600' : 'border-transparent text-neutral-500 hover:text-neutral-700 hover:border-neutral-300' }" do %>
        Mis Reportes
      <% end %>

      <%= link_to reports_path(tab: 'community'), class: "whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition #{ @current_tab == 'community' ? 'border-blue-500 text-blue-600' : 'border-transparent text-neutral-500 hover:text-neutral-700 hover:border-neutral-300' }" do %>
        Comunidad
      <% end %>
    </nav>
  </div>

  <% if @reports.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @reports.each do |report| %>
        <div class="bg-white rounded-2xl shadow-sm border border-neutral-200 overflow-hidden flex flex-col transition hover:shadow-md">
          <!-- Card Header / Image -->
          <div class="relative h-48 bg-neutral-100 flex-shrink-0">
            <% if report.photo.attached? %>
              <%= image_tag report.photo, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center text-neutral-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-xs font-medium">Sin foto</span>
              </div>
            <% end %>

            <!-- Badge -->
            <div class="absolute top-3 right-3 flex flex-col gap-1 items-end">
              <% if report.user_id == Current.user.id %>
                <% if report.draft? %>
                  <span class="bg-yellow-100/90 backdrop-blur text-yellow-800 text-xs font-bold px-2.5 py-1 rounded-lg border border-yellow-200 shadow-sm">Borrador</span>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-4 flex flex-col flex-grow">
            <% animal = report.animal %>
            <h3 class="text-lg font-bold text-neutral-800 mb-1 capitalize truncate">
              <%= animal&.species.presence || "Especie desconocida" %>
            </h3>

            <div class="space-y-1.5 text-sm text-neutral-600 mb-4 flex-grow">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                <span class="truncate"><%= animal&.race.presence || "Raza sin especificar" %></span>
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span><%= animal&.age.present? ? "#{animal.age} años aprox." : "Edad sin especificar" %></span>
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span class="truncate"><%= report.location ? "Ubicación adjunta" : "Sin ubicación" %></span>
              </div>
            </div>

            <div class="mt-auto pt-4 border-t border-neutral-100">
              <% if report.user_id == Current.user.id %>
                <% if report.draft? %>
                  <%= link_to new_report_path(report_id: report.id), class: "block w-full text-center bg-neutral-100 hover:bg-neutral-200 text-neutral-700 font-semibold text-sm px-4 py-2.5 rounded-xl transition" do %>
                    Continuar edición
                  <% end %>
                <% else %>
                  <button class="block w-full text-center bg-white border border-neutral-200 text-neutral-400 font-semibold text-sm px-4 py-2.5 rounded-xl cursor-not-allowed">
                    Finalizado
                  </button>
                <% end %>
              <% else %>
                <button class="block w-full text-center bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm px-4 py-2.5 rounded-xl transition shadow-sm">
                  Interactuar
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-neutral-50 rounded-3xl border border-neutral-100">
      <div class="bg-blue-100 p-4 rounded-full mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>

      <% if @current_tab == "community" %>
        <h2 class="text-xl font-bold text-neutral-800 mb-2">Aún no hay reportes</h2>
        <p class="text-neutral-500 max-w-sm mb-6">Parece que ningún usuario ha publicado reportes todavía. ¡Sé el primero en aportar!</p>
      <% else %>
        <h2 class="text-xl font-bold text-neutral-800 mb-2">No tienes reportes todavía</h2>
        <p class="text-neutral-500 max-w-sm mb-6">Parece que aún no has creado ningún reporte de animales. ¡Haz tu primer reporte ahora mismo!</p>
      <% end %>
    </div>
  <% end %>
</div>
