<div id="step-location-container" class="space-y-2 animate-fade-in">
  <div class="flex items-start gap-3">
    <div class="bg-neutral-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-neutral-800 max-w-[85%] text-sm">
      ¡Hola! Para registrar un nuevo reporte, primero necesito que compartas tu ubicación actual.

      <%= form_with url: reports_path, method: :post, class: "mt-3", data: { controller: "chat-gps" } do |f| %>
        <%= hidden_field_tag :browser_lat, nil, data: { chat_gps_target: "lat" } %>
        <%= hidden_field_tag :browser_lng, nil, data: { chat_gps_target: "lng" } %>
        <%= hidden_field_tag :is_edit, local_assigns[:is_edit] %>

        <button type="button" data-action="click->chat-gps#request" data-chat-gps-target="btn" class="bg-blue-600 text-white font-semibold text-xs px-4 py-2.5 rounded-xl shadow-sm hover:bg-blue-700 transition">
          Compartir mi ubicación
        </button>
      <% end %>
      <p id="gps-warning" class="hidden text-red-500 text-xs mt-2 font-semibold"></p>
    </div>
  </div>
</div>
