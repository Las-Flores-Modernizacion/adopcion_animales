<div id="step-animal-race-container" class="animate-fade-in space-y-3">
  <div class="flex items-start gap-3">
    <div class="bg-neutral-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-neutral-800 max-w-[85%] w-full text-sm">
      ¿Reconocés la raza o podés describirla brevemente? (Ej: Mestizo, Ovejero, o si no sabés escribí "No sé")

      <%= form_with model: @animal, url: answer_animal_step_reports_path(current_field: :race, next_field: :age), method: :post, class: "mt-3 flex gap-2" do |f| %>
        <%= f.text_field :race, required: true, class: "bg-white border border-neutral-300 text-sm px-3 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 flex-grow" %>
        <%= f.submit "Enviar", class: "bg-blue-600 text-white font-semibold text-xs px-4 py-2 rounded-xl hover:bg-blue-700 transition" %>
      <% end %>

      <div id="step-animal-race-error"></div>
    </div>
  </div>
</div>
