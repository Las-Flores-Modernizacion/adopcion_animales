<div id="step-animal-species-container" class="animate-fade-in space-y-3">
  <div class="flex items-start gap-3">
    <div class="bg-neutral-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-neutral-800 max-w-[85%] text-sm">
      ¿De qué especie se trata el animal que estás reportando? 🐾

      <%= form_with model: @animal, url: answer_animal_step_reports_path(current_field: :species, next_field: :race), method: :post, class: "mt-3 flex gap-2" do |f| %>
        <button type="submit" name="animal[species]" value="perro" class="bg-white border border-neutral-300 text-neutral-700 font-semibold text-xs px-4 py-2 rounded-xl hover:bg-neutral-50 shadow-sm">🐶 Perro</button>
        <button type="submit" name="animal[species]" value="gato" class="bg-white border border-neutral-300 text-neutral-700 font-semibold text-xs px-4 py-2 rounded-xl hover:bg-neutral-50 shadow-sm">🐱 Gato</button>
      <% end %>

      <div id="step-animal-species-error"></div>
    </div>
  </div>
</div>
