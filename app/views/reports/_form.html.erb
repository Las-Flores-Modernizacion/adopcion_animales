<%= form_with(model: report, class: "space-y-6") do |form| %>
  <% if report.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/30 p-4 rounded-xl border border-red-200 dark:border-red-800">
      <h3 class="text-sm font-medium text-red-800 dark:text-red-400">Por favor revisa los siguientes errores:</h3>
      <ul class="mt-2 text-sm text-red-700 dark:text-red-300 list-disc pl-5">
        <% report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Banner Informativo -->
  <div class="p-4 rounded-xl bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/60 text-blue-900 dark:text-blue-200 text-sm flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span>Los campos marcados con <strong class="text-red-600 dark:text-red-400">* Obligatorio</strong> son requeridos para publicar.</span>
    </div>
  </div>

  <!-- Tarjeta: Visualización y Carga de Fotografías -->
  <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-6" data-controller="image-preview">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Fotografías del Animal</h3>
        <p class="text-sm text-neutral-500 mt-1">Revisa las imágenes guardadas o añade más para facilitar la identificación.</p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
        Opcional (Paso 2)
      </span>
    </div>

    <!-- Muestra solo de fotos persistidas en BD -->
    <% saved_photos = report.photo.select(&:persisted?) %>
    <% if saved_photos.any? %>
      <div class="space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 block">
          Fotos adjuntas (<%= saved_photos.count %>)
        </span>

        <% slides = saved_photos.map do |p|
          {
            content: image_tag(p, class: "w-full h-48 sm:h-56 object-cover rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-xs")
          }
        end %>

        <%= render "shared/components/carousel/carousel",
            slides: slides,
            slide_size: "third",
            dots: true,
            buttons: true
        %>
      </div>
    <% end %>

    <!-- Opciones para agregar más fotos -->
    <div class="border-t border-neutral-100 dark:border-neutral-800 pt-5 space-y-4">
      <label class="block text-sm font-medium text-neutral-900 dark:text-white">
        Agregar imágenes <span class="text-xs text-neutral-400 font-normal">(Opcional)</span>
      </label>

      <!-- Contenedor dinámico de previsualización JS -->
      <div data-image-preview-target="previewContainer" class="hidden grid grid-cols-3 md:grid-cols-4 gap-3 mb-4">
      </div>

      <div class="p-6 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/30 text-center flex flex-col items-center justify-center gap-4 transition-colors hover:border-neutral-400 dark:hover:border-neutral-500">
        <div class="p-3 rounded-full bg-neutral-200/50 dark:bg-neutral-700/50 text-neutral-600 dark:text-neutral-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-neutral-900 dark:text-white block">Selecciona o toma fotos del animal</p>
          <p class="text-xs text-neutral-500 mt-1">Formatos soportados: JPG, PNG, WEBP</p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 w-full sm:w-auto">
          <!-- Botón Cámara -->
          <label class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg text-neutral-700 bg-white border border-neutral-300 shadow-sm hover:bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-200 dark:border-neutral-600 dark:hover:bg-neutral-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><circle cx="12" cy="13" r="3" stroke-width="2" /></svg>
            Tomar foto
            <%= form.file_field :photo,
                multiple: true,
                direct_upload: true,
                accept: "image/*",
                capture: "environment",
                data: {
                  compressor_target: "input",
                  image_preview_target: "input",
                  action: "change->compressor#compress change->image-preview#preview"
                },
                class: "hidden" %>
          </label>

          <!-- Botón Galería -->
          <label class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg text-white bg-neutral-900 shadow-sm hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Galería
            <%= form.file_field :photo,
                multiple: true,
                direct_upload: true,
                accept: "image/jpeg, image/png, image/webp, image/avif, image/heic",
                data: {
                  compressor_target: "input",
                  image_preview_target: "input",
                  action: "change->compressor#compress change->image-preview#preview"
                },
                class: "hidden" %>
          </label>
        </div>
      </div>
    </div>
  </div>

  <%= form.fields_for :animal do |animal_form| %>
    <!-- Tarjeta: Identificación Básica -->
    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-5">
      <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Identificación del Animal</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <%= render "shared/components/forms/form_group",
            label: "Especie *",
            name: "report[animal_attributes][species]",
            helper_text: "Requerido" do %>
          <%= animal_form.select :species,
              Animal.species.keys.map { |s| [s.titleize, s] },
              { prompt: "Selecciona una..." },
              required: true,
              class: "w-full rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-neutral-900 dark:focus:ring-white focus:border-neutral-900 dark:focus:border-white" %>
        <% end %>

        <%= render "shared/components/forms/form_group",
            label: "Tamaño aproximado *",
            name: "report[animal_attributes][size]",
            helper_text: "Requerido" do %>
          <%= animal_form.select :size,
              Animal.sizes.keys.map { |s| [s.titleize, s] },
              { prompt: "Selecciona uno..." },
              required: true,
              class: "w-full rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-neutral-900 dark:focus:ring-white focus:border-neutral-900 dark:focus:border-white" %>
        <% end %>

        <%= render "shared/components/forms/form_group",
            label: "Color principal (Opcional)",
            name: "report[animal_attributes][color]",
            helper_text: "Ej. Negro con manchas blancas" do %>
          <%= animal_form.text_field :color,
              class: "w-full rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-neutral-900 dark:focus:ring-white focus:border-neutral-900 dark:focus:border-white" %>
        <% end %>

        <%= render "shared/components/forms/form_group",
            label: "Raza (Opcional)",
            name: "report[animal_attributes][race]",
            helper_text: "Si la conoces" do %>
          <%= animal_form.text_field :race,
              class: "w-full rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-neutral-900 dark:focus:ring-white focus:border-neutral-900 dark:focus:border-white" %>
        <% end %>
      </div>
    </div>

    <!-- Tarjeta: Estado y Comportamiento (Opcional) -->
    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-5">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Estado y Comportamiento</h3>
        <span class="text-xs font-medium text-neutral-400">(Opcional)</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="flex items-start p-4 border border-neutral-200 dark:border-neutral-700 rounded-xl cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
          <div class="flex items-center h-5">
            <%= animal_form.check_box :urgent, class: "rounded border-neutral-300 text-red-600 focus:ring-red-600 size-5" %>
          </div>
          <div class="ml-3 text-sm">
            <span class="font-medium text-neutral-900 dark:text-white block">Caso Urgente</span>
            <span class="text-neutral-500 text-xs">Requiere asistencia inmediata</span>
          </div>
        </label>

        <label class="flex items-start p-4 border border-neutral-200 dark:border-neutral-700 rounded-xl cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
          <div class="flex items-center h-5">
            <%= animal_form.check_box :is_hurt, class: "rounded border-neutral-300 text-orange-600 focus:ring-orange-600 size-5" %>
          </div>
          <div class="ml-3 text-sm">
            <span class="font-medium text-neutral-900 dark:text-white block">Está herido</span>
            <span class="text-neutral-500 text-xs">Presenta lesiones visibles</span>
          </div>
        </label>

        <label class="flex items-start p-4 border border-neutral-200 dark:border-neutral-700 rounded-xl cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
          <div class="flex items-center h-5">
            <%= animal_form.check_box :aggressive, class: "rounded border-neutral-300 text-neutral-900 dark:text-white focus:ring-neutral-900 size-5" %>
          </div>
          <div class="ml-3 text-sm">
            <span class="font-medium text-neutral-900 dark:text-white block">Comportamiento agresivo</span>
            <span class="text-neutral-500 text-xs">Precaución al acercarse</span>
          </div>
        </label>

        <label class="flex items-start p-4 border border-neutral-200 dark:border-neutral-700 rounded-xl cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
          <div class="flex items-center h-5">
            <%= animal_form.check_box :is_anxious, class: "rounded border-neutral-300 text-neutral-900 dark:text-white focus:ring-neutral-900 size-5" %>
          </div>
          <div class="ml-3 text-sm">
            <span class="font-medium text-neutral-900 dark:text-white block">Asustado o ansioso</span>
            <span class="text-neutral-500 text-xs">Tiembla o se esconde</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Tarjeta: Detalles extra -->
    <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Detalles adicionales</h3>
        <span class="text-xs font-medium text-neutral-400">(Opcional)</span>
      </div>

      <%= render "shared/components/forms/form_group",
          label: "Rasgos distintivos",
          name: "report[animal_attributes][unique_detail]",
          helper_text: "Ej. Le falta media oreja, tiene un collar rojo sin chapa, cojea, etc." do %>
        <%= animal_form.text_area :unique_detail,
            rows: 3,
            class: "w-full rounded-lg border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-neutral-900 dark:focus:ring-white focus:border-neutral-900 dark:focus:border-white" %>
      <% end %>
    </div>
  <% end %>

  <!-- Botones de acción -->
  <div class="flex flex-col sm:flex-row justify-end gap-3 pt-2">
    <%= render "shared/components/buttons/button",
      text: "Guardar y publicar reporte",
      type: "submit",
      style: "fancy"
    %>
  </div>
<% end %>
