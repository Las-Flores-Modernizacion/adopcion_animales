<%#
  Help Menu (Ayudar)
  Botón "Ayudar" con un desplegable de acciones distintas sobre el mismo reporte:
  avistar, dar tránsito, pedir adopción. Reemplaza el link directo a "nuevo avistamiento".

  Required locals:
    - report: Report

  Optional locals:
    - classes: String (default: nil) - Clases extra para el wrapper (p.ej. "flex-1" en una card)
    - button_size: String (default: "sm") - Tamaño del botón, ver componente button
%>

<% classes = local_assigns.fetch(:classes, nil) %>
<% button_size = local_assigns.fetch(:button_size, "sm") %>

<div class="relative <%= classes %>" data-controller="dropdown" data-action="click@window->dropdown#hideOnClickOutside">
  <%= render "shared/components/buttons/button",
      text: "Ayudar",
      style: "fancy",
      variant: "info",
      size: button_size,
      classes: "w-full justify-center",
      data: { "dropdown-target": "button", action: "click->dropdown#toggle" }
  %>

  <div class="hidden opacity-0 -translate-y-2 absolute left-0 right-0 sm:right-auto top-full mt-2 w-full sm:w-64 bg-white dark:bg-neutral-900 rounded-2xl p-2 shadow-2xl shadow-neutral-900/10 dark:shadow-neutral-950/50 ring-1 ring-neutral-900/10 dark:ring-white/10 border border-neutral-100 dark:border-neutral-800 z-30 transition-all duration-200 ease-out space-y-1"
       data-dropdown-target="menu">
    <%= link_to new_report_sighting_path(report, status: "avistado"), class: "block px-3 py-2.5 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-800/70 transition-colors" do %>
      <span class="block text-sm font-medium text-neutral-900 dark:text-white">Avisté a este animal</span>
      <span class="block text-xs text-neutral-500">Contá dónde lo viste ahora</span>
    <% end %>

    <%= link_to new_report_sighting_path(report, status: "en_transito"), class: "block px-3 py-2.5 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-800/70 transition-colors" do %>
      <span class="block text-sm font-medium text-neutral-900 dark:text-white">Le doy tránsito</span>
      <span class="block text-xs text-neutral-500">Lo alojás en tu casa mientras se busca adoptante</span>
    <% end %>

    <%= link_to new_report_sighting_path(report, status: "en_proceso_adopcion"), class: "block px-3 py-2.5 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-800/70 transition-colors" do %>
      <span class="block text-sm font-medium text-neutral-900 dark:text-white">Quiero adoptarlo</span>
      <span class="block text-xs text-neutral-500">Cuidado Animal se contacta para coordinar</span>
    <% end %>
  </div>
</div>
