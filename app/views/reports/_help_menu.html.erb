<%#
  Help Menu (Ayudar)
  Botón "Ayudar" con un desplegable de acciones distintas sobre el mismo reporte:
  avistar, dar tránsito, pedir adopción. Reemplaza el link directo a "nuevo avistamiento".

  Required locals:
    - report: Report

  Optional locals:
    - classes: String (default: nil) - Clases extra para el wrapper (p.ej. "flex-1" en una card)
    - button_size: String (default: "sm") - Tamaño del botón trigger, ver componente button
    - full_width: Boolean (default: true) - Si el botón trigger ocupa todo el ancho disponible.
      Usar false para un botón compacto (p.ej. junto a un badge de estado).
    - direction: String (default: "down") - Hacia dónde abre el menú respecto del botón: "down" o
      "up". El menú se posiciona con position:fixed vía JS (ver dropdown_controller#positionMenu)
      en vez de con clases de Tailwind, precisamente para no depender de dónde caiga dentro del
      flujo normal — así ignora cualquier overflow-hidden de sus contenedores (como una card).
%>

<% classes = local_assigns.fetch(:classes, nil) %>
<% button_size = local_assigns.fetch(:button_size, "sm") %>
<% full_width = local_assigns.fetch(:full_width, true) %>
<% direction = local_assigns.fetch(:direction, "down") %>

<div class="relative <%= classes %>" data-controller="dropdown" data-action="click@window->dropdown#hideOnClickOutside">
  <%= render "shared/components/buttons/button",
      text: "Ayudar",
      style: "fancy",
      variant: "info",
      size: button_size,
      full_width: full_width,
      classes: full_width ? "justify-center" : nil,
      data: { "dropdown-target": "button", action: "click->dropdown#toggle" }
  %>

  <div class="hidden opacity-0 -translate-y-2 w-64 max-w-[calc(100vw-2rem)] bg-white dark:bg-neutral-900 rounded-2xl p-2 shadow-2xl shadow-neutral-900/10 dark:shadow-neutral-950/50 ring-1 ring-neutral-900/10 dark:ring-white/10 border border-neutral-100 dark:border-neutral-800 z-50 transition-all duration-200 ease-out space-y-1"
       data-dropdown-target="menu"
       data-dropdown-fixed-position="true"
       data-dropdown-direction="<%= direction %>">
    <%= render "shared/components/buttons/button",
        text: "Avisté a este animal", href: new_report_sighting_path(report, status: "avistado"),
        variant: "secondary", style: "fancy", size: "sm", full_width: true, classes: "!justify-start" %>

    <%= render "shared/components/buttons/button",
        text: "Le doy tránsito", href: new_report_sighting_path(report, status: "en_transito"),
        variant: "secondary", style: "fancy", size: "sm", full_width: true, classes: "!justify-start" %>

    <%= render "shared/components/buttons/button",
        text: "Quiero adoptarlo", href: new_report_sighting_path(report, status: "en_proceso_adopcion"),
        variant: "secondary", style: "fancy", size: "sm", full_width: true, classes: "!justify-start" %>
  </div>
</div>
