<% content_for :title, "Mapa de Reportes" %>

<% markers = @reports.map do |report|
  {
    lat: report.location.latitude.to_f,
    lng: report.location.longitude.to_f,
    label: "#{report.animal&.species.presence&.titleize || 'Animal'} — #{status_label(report.status)}",
    color: status_map_color(report.status),
    url: admin_report_path(report)
  }
end %>

<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6">
  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800 dark:text-neutral-100">Mapa de Reportes</h1>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">Todos los reportes publicados, coloreados según su estado actual.</p>
  </div>

  <%= render "admin/subnav", current: "mapa" %>

  <div class="flex flex-wrap gap-3 mb-4">
    <% Report::STATUSES.each_key do |status| %>
      <div class="flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400">
        <span class="size-2.5 rounded-full inline-block" style="background-color: <%= status_map_color(status) %>"></span>
        <%= status_label(status) %>
      </div>
    <% end %>
  </div>

  <div
    class="w-full h-[70vh] rounded-2xl overflow-hidden border border-neutral-200 dark:border-neutral-800 z-0"
    data-controller="admin-reports-map"
    data-admin-reports-map-markers-value="<%= markers.to_json %>"
  ></div>
</div>
