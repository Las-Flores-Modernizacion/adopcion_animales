<% content_for :title, "Detalle del Reporte" %>

<% animal = @report.animal %>
<% sightings = @report.sightings.order(created_at: :desc).to_a %>

<div class="max-w-5xl mx-auto py-8 px-4 sm:px-6">
  <div class="mb-6">
    <%= render "shared/components/buttons/button", text: "Volver a reportes", href: admin_reports_path, variant: "ghost", size: "sm",
        icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>' %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 lg:gap-8 items-start">
    <div class="lg:col-span-3 space-y-6">
      <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm overflow-hidden">
        <% if @report.photo.attached? %>
          <% slides = @report.photo.map { |p| { content: image_tag(p, class: "w-full h-80 sm:h-96 object-contain bg-neutral-100 dark:bg-neutral-950") } } %>
          <%= render "shared/components/carousel/carousel", slides: slides, slide_size: "full", dots: true, buttons: true, show_gradients: false, edge_to_edge: true %>
        <% else %>
          <div class="w-full h-80 sm:h-96 flex items-center justify-center text-neutral-400 bg-neutral-100 dark:bg-neutral-800">
            <span class="text-sm font-medium">Sin fotos</span>
          </div>
        <% end %>
      </div>

      <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm p-6 space-y-5">
        <div>
          <h1 class="text-2xl font-bold text-neutral-900 dark:text-white capitalize"><%= animal&.species.presence || "Especie desconocida" %></h1>
          <p class="text-neutral-500"><%= animal&.race.presence || "Raza sin especificar" %></p>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-4 text-sm">
          <div>
            <dt class="text-neutral-500 mb-0.5">Tamaño</dt>
            <dd class="text-neutral-900 dark:text-white font-medium capitalize"><%= animal&.size.presence || "Sin especificar" %></dd>
          </div>
          <div>
            <dt class="text-neutral-500 mb-0.5">Color</dt>
            <dd class="text-neutral-900 dark:text-white font-medium"><%= animal&.color.presence || "Sin especificar" %></dd>
          </div>
          <div>
            <dt class="text-neutral-500 mb-0.5">Edad aprox.</dt>
            <dd class="text-neutral-900 dark:text-white font-medium"><%= animal&.age.present? ? "#{animal.age} años" : "Sin especificar" %></dd>
          </div>
        </dl>
      </div>

      <% if sightings.any? %>
        <%= render "reports/mobility_map", report: @report, sightings: sightings %>
      <% end %>
    </div>

    <div class="lg:col-span-2 space-y-6 lg:sticky lg:top-6">
      <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-neutral-500">Estado actual</span>
            <%= render "shared/components/badge/badge", text: status_label(@report.status), variant: status_badge_variant(@report.status), pill: true %>
          </div>
        </div>

        <dl class="text-sm space-y-2">
          <div class="flex justify-between gap-2">
            <dt class="text-neutral-500">Reportante</dt>
            <dd class="text-neutral-900 dark:text-white font-medium"><%= @report.user.full_name.titleize %></dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-neutral-500">Email</dt>
            <dd class="text-neutral-900 dark:text-white font-medium"><%= @report.user.account.email_address %></dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-neutral-500">Creado</dt>
            <dd class="text-neutral-900 dark:text-white font-medium"><%= @report.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
          </div>
        </dl>

        <% badges = [
          (["Urgente", "red"] if @report.urgent?),
          (["Herido", "orange"] if @report.is_hurt?),
          (["Ansioso", "yellow"] if @report.is_anxious?),
          (["Comportamiento agresivo", "neutral"] if @report.aggressive?)
        ].compact %>

        <% if badges.any? %>
          <div class="flex flex-wrap gap-2">
            <% badges.each do |label, variant| %>
              <%= render "shared/components/badge/badge", text: label, variant: variant %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm p-6">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-white mb-4">Cronología</h2>

        <ul class="space-y-0">
          <% sightings.each_with_index do |sighting, index| %>
            <li class="relative flex gap-3 pb-6 last:pb-0">
              <% unless index == sightings.size - 1 %>
                <span class="absolute left-[15px] top-8 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800"></span>
              <% end %>

              <%= render "shared/components/avatar/avatar",
                  alt: sighting.user.full_name.titleize, src: sighting.user.avatar_url, size: "sm",
                  classes: "relative z-10 flex-shrink-0" %>

              <div class="min-w-0 pt-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <%= render "shared/components/badge/badge", text: status_label(sighting.status), variant: status_badge_variant(sighting.status), size: "sm", pill: true %>
                  <span class="text-sm font-medium text-neutral-900 dark:text-white"><%= sighting.user.full_name.titleize %></span>
                </div>
                <p class="text-xs text-neutral-500 mt-1"><%= time_ago_in_words(sighting.created_at) %> atrás</p>
              </div>
            </li>
          <% end %>

          <% if sightings.empty? %>
            <li class="text-sm text-neutral-400">Todavía no hay novedades registradas.</li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
